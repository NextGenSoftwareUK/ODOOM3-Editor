// OASIS Omniverse — ODOOM3 entity definitions for DarkRadiant
// Copy this file to <Doom3Install>/base/def/ to make these entities available in the editor.
// Thing type range: 10001–10999 (ODOOM3)
// Portal: 5900 (shared cross-game)

entityDef oasis_portal
{
    "editor_color"          "0 0.75 1"
    "editor_mins"           "-12 -12 -12"
    "editor_maxs"           "12 12 12"
    "editor_usage"          "OASIS Omniverse cross-game portal. Connects this Doom 3 map to other OASIS Omniverse games. OASIS thing type 5900."
    "editor_displayFolder"  "OASIS Omniverse"

    "oasis_game_id"         ""
    "editor_var oasis_game_id"  "Target OGame ID (e.g. oquake, oquake2, odoom, oduke3d, owolf3d)"

    "oasis_thing_type"      "5900"
    "editor_var oasis_thing_type"  "OASIS thing type (5900 = portal, shared across all OGames)"
}

