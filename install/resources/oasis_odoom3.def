// OASIS Omniverse — ODOOM3 entity definitions for DarkRadiant
// Copy this file to <Doom3Install>/base/def/ to make these entities available in the editor.
// Thing type range: 10001–10999 (ODOOM3)
// Portal: 5900 (shared cross-game)

entityDef oasis_portal_enter
{
    "editor_color"          "0 0.75 1"
    "editor_usage"          "OASIS teleport source — brush entity the player walks into to be sent to another OASIS game or map. In DarkRadiant: create a brush, then apply this entity class to it. OASIS thing type 5900."
    "editor_displayFolder"  "OASIS Omniverse/Portals"

    "oasis_game_id"         ""
    "editor_var oasis_game_id"      "Destination game (e.g. oquake, oquake2, oquake3, oduke3d, owolf3d)"

    "oasis_map"             ""
    "editor_var oasis_map"          "Destination map name in the target game (e.g. mars_city1, caverns)"

    "oasis_exit_name"       ""
    "editor_var oasis_exit_name"    "targetname of the oasis_portal_exit in the destination map where the player will spawn"

    "message"               ""
    "editor_var message"            "Optional text shown to the player when they enter this portal"
}

entityDef oasis_portal_exit
{
    "editor_color"          "0 1 0.75"
    "editor_mins"           "-16 -16 -24"
    "editor_maxs"           "16 16 24"
    "editor_usage"          "OASIS teleport destination — point entity marking where players arrive from another OASIS game or map. Place at the exit of the portal frame. OASIS thing type 5900."
    "editor_displayFolder"  "OASIS Omniverse/Portals"

    "targetname"            ""
    "editor_var targetname"         "Must match the oasis_exit_name on the corresponding oasis_portal_enter in the source map"

    "angle"                 "0"
    "editor_var angle"              "Direction the player faces on arrival (0=east, 90=north, 180=west, 270=south)"

    "oasis_thing_type"      "5900"
    "editor_var oasis_thing_type"   "OASIS thing type"
}

entityDef oasis_portal
{
    "editor_color"          "0 0.75 1"
    "editor_mins"           "-12 -12 -12"
    "editor_maxs"           "12 12 12"
    "editor_usage"          "OASIS Omniverse legacy portal point. Prefer oasis_portal_enter + oasis_portal_exit for new maps. OASIS thing type 5900."
    "editor_displayFolder"  "OASIS Omniverse/Portals"

    "oasis_game_id"         ""
    "editor_var oasis_game_id"  "Target OGame ID (e.g. oquake, oquake2, odoom, oduke3d, owolf3d)"

    "oasis_thing_type"      "5900"
    "editor_var oasis_thing_type"  "OASIS thing type (5900 = portal, shared across all OGames)"
}

entityDef oasis_key_blue
{
    "editor_color"          "0 0.5 1"
    "editor_mins"           "-8 -8 -8"
    "editor_maxs"           "8 8 8"
    "editor_usage"          "OASIS blue key — collected cross-game via STAR inventory. OASIS thing type 10001."
    "editor_displayFolder"  "OASIS Omniverse/Keys"

    "oasis_thing_type"      "10001"
    "editor_var oasis_thing_type"  "OASIS thing type"
}

